{
    "name": "JetKVM Helper",
    "version": "0.0.0.1",
    "manifest_version": 3,
    "description": "Adds screenshot and video capture buttons to the JetKVM UI, plus optional URL-triggered keystrokes for scripting.",
    "homepage_url": "https://github.com/andrewiankidd/BrowserExtensions/tree/master/jetkvm-helper",
    "icons": {
        "16": "icons/logo16.png",
        "32": "icons/logo32.png",
        "48": "icons/logo48.png",
        "128": "icons/logo128.png"
    },
    "action": {
        "default_popup": "main/main.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "jetkvm-helper@andrewkidd.co.uk",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "content_scripts": [{
        "matches": [
            "*://*/*"
        ],
        "js": [
            "inject/inject.js"
        ],
        "run_at": "document_idle",
        "all_frames": false
    }]
}
